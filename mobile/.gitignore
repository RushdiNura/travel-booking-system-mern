# Dependencies
node_modules/

# Expo
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts

# Native projects — generated by `npx expo prebuild` (Continuous Native
# Generation), so they're rebuilt from app.json + config plugins rather than
# committed. Remove these two lines if you ever hand-edit native code and
# want to commit ios/ and android/ instead.
/ios
/android

# Environment files — secrets stay local. The template is committed.
.env
.env.*
!.env.example

# Signing keys & credentials — never commit these
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
*.pem
google-services.json
GoogleService-Info.plist

# Metro / bundler
.metro-health-check*
*.tsbuildinfo

# EAS local builds
*.apk
*.aab
*.ipa

# Logs
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json